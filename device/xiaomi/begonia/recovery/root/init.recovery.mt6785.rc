import /microtrust_begonia.rc
import /init.recovery.wifi.rc

on early-init
    setprop service.adb.tcp.port 5555
    setprop keymaster_ver 4.0
    setprop ro.crypto.volume.options aes-256-xts:aes-256-cts:v1
    setprop ro.crypto.volume.filenames_mode aes-256-cts:v1
    start adbd
    mkdir /Fox 0777 root root
    mkdir /Fox/FoxFiles 0777 root root
    mkdir /Fox/theme 0777 root root
    mkdir /tmp/Fox 0777 root root
    mkdir /tmp/Fox/FoxFiles 0777 root root
    mkdir /tmp/Fox/theme 0777 root root

on init
    # Create a more standard /dev/block layout for our scripts
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    # Let the bundled curl validate HTTPS against the recovery CA bundle.
    export CURL_CA_BUNDLE /system/etc/security/cacert.pem
    start hwservicemanager
    start servicemanager
    # Auto-detect dynamic vs non-dynamic partition layout
    exec u:r:recovery:s0 -- /system/bin/detect_partition_layout.sh

on boot
    setprop service.adb.tcp.port 5555
    start hwservicemanager
    start servicemanager
    start teei_daemon
    start keymaster-4-0-beanpod
    start gatekeeper-1-0

    # Flashlight / Torch sysfs nodes & symlink
    chmod 0666 /sys/class/leds/flashlight/brightness
    chmod 0666 /sys/class/leds/torch-light0/brightness
    symlink /sys/class/leds/flashlight/brightness /system/etc/flashlight

    # Haptic feedback & vibrator sysfs nodes
    chmod 0666 /sys/class/timed_output/vibrator/enable
    chmod 0666 /sys/class/leds/vibrator/activate
    chmod 0666 /sys/class/leds/vibrator/duration
    chmod 0666 /sys/class/leds/vibrator/state

on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    install_keyring

on fs
    # Recovery init does not always import /system/etc/init before the
    # crypto HAL property triggers fire.  Start the HIDL/AIDL service
    # managers explicitly (as the known-working begonia TWRP trees do), so
    # hwservicemanager.ready can start teei/keymaster/gatekeeper before the
    # first /data decryption attempt.
    start hwservicemanager
    start servicemanager

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service keymaster-4-0-beanpod /vendor/bin/hw/android.hardware.keymaster@4.0-service.beanpod
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0

on property:hwservicemanager.ready=true
    write /proc/bootprof "start teei_daemon (on fs)"
    start teei_daemon
    write /proc/bootprof "start teei_daemon end (on fs)"
    start keymaster-4-0-beanpod
    start gatekeeper-1-0

on property:ro.crypto.state=unsupported
    stop teei_daemon
    stop keymaster-4-0-beanpod
    stop gatekeeper-1-0
    stop servicemanager
    stop hwservicemanager

on property:ro.crypto.state=unencrypted
    stop teei_daemon
    stop keymaster-4-0-beanpod
    stop gatekeeper-1-0
    stop servicemanager
    stop hwservicemanager

on property:twrp.decrypt.done=true
    stop teei_daemon
    stop keymaster-4-0-beanpod
    stop gatekeeper-1-0
    stop servicemanager
    stop hwservicemanager

