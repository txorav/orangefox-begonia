#!/system/bin/sh
# Minimal dhcpcd hook for recovery.
#
# The stock Android dhcpcd-run-hooks script is not part of the recovery
# ramdisk, and dhcpcd itself does not configure the interface: it only obtains
# the lease and calls its hook.  This script applies the address, default route
# and DNS servers for the common DHCP reasons.
#
# dhcpcd-6.8.2 passes the lease in environment variables such as
# new_ip_address, new_subnet_mask, new_routers and new_domain_name_servers.

case "$reason" in
    BOUND|RENEW|REBIND|REBOOT)
        [ -n "$new_ip_address" ] || exit 0
        if [ -n "$new_broadcast_address" ]; then
            ifconfig "$interface" "$new_ip_address" netmask "$new_subnet_mask" \
                broadcast "$new_broadcast_address" up
        else
            ifconfig "$interface" "$new_ip_address" netmask "$new_subnet_mask" up
        fi
        if [ -n "$new_routers" ]; then
            for r in $new_routers; do
                if [ -x /system/bin/busybox ]; then
                    /system/bin/busybox route add default gw "$r" dev "$interface" 2>/dev/null && break
                else
                    route add default gw "$r" dev "$interface" 2>/dev/null && break
                fi
            done
        fi
        {
            for d in $new_domain_name_servers; do
                echo "nameserver $d"
            done
            echo "nameserver 1.1.1.1"
            echo "nameserver 8.8.8.8"
            echo "nameserver 1.0.0.1"
            echo "nameserver 8.8.4.4"
            echo "options timeout:2 attempts:3 rotate"
        } > /system/etc/resolv.conf 2>/dev/null
        cp -f /system/etc/resolv.conf /etc/resolv.conf 2>/dev/null || true
        cp -f /system/etc/resolv.conf /tmp/resolv.conf 2>/dev/null || true

        # Update Android system properties for Bionic libc getaddrinfo
        idx=1
        for d in $new_domain_name_servers; do
            setprop "net.dns$idx" "$d" 2>/dev/null || true
            setprop "net.${interface}.dns$idx" "$d" 2>/dev/null || true
            idx=$((idx + 1))
            [ "$idx" -gt 2 ] && break
        done
        [ "$idx" -le 1 ] && setprop net.dns1 1.1.1.1 2>/dev/null && setprop "net.${interface}.dns1" 1.1.1.1 2>/dev/null
        [ "$idx" -le 2 ] && setprop net.dns2 8.8.8.8 2>/dev/null && setprop "net.${interface}.dns2" 8.8.8.8 2>/dev/null
        setprop net.dns3 1.0.0.1 2>/dev/null || true
        setprop net.dns4 8.8.4.4 2>/dev/null || true
        setprop net.change.dns 1 2>/dev/null || true
        if [ -x /system/bin/foxadb ]; then
            /system/bin/foxadb on >/dev/null 2>&1
        else
            setprop service.adb.tcp.port 5555
            setprop ctl.restart adbd 2>/dev/null
        fi
        echo "$(date '+%H:%M:%S') Wireless ADB active: adb connect ${new_ip_address}:5555" >> /tmp/foxadb.log 2>/dev/null
        ;;
    RELEASE|NAK|EXPIRE|FAIL|STOP)
        ifconfig "$interface" 0.0.0.0 2>/dev/null
        ;;
esac

exit 0
