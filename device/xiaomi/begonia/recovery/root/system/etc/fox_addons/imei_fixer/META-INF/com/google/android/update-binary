#!/system/bin/sh
#
# update-binary for Begonia IMEI Fixer Fox Addon
#

OUTFD=$2

ui_print() {
    echo "ui_print $1" >&$OUTFD
    echo "ui_print" >&$OUTFD
}

ui_print "==========================================="
ui_print "  ORANGEFOX BEGONIA NATIVE IMEI FIXER      "
ui_print "==========================================="
ui_print "-> Mounting NVRAM and storage partitions..."

mount /mnt/vendor/nvdata 2>/dev/null || mount /nvdata 2>/dev/null || true
mount /mnt/vendor/protect1 2>/dev/null || true
mount /mnt/vendor/protect2 2>/dev/null || true
mount /data 2>/dev/null || true

if [ -x /system/bin/foximei ]; then
    ui_print "-> Launching Native Fox IMEI Keypad & Editor..."
    /system/bin/foximei menu
    ui_print "✓ IMEI configuration applied."
else
    ui_print "Error: /system/bin/foximei binary not found."
    exit 1
fi

ui_print "==========================================="
exit 0
